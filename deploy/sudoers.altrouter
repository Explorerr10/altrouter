altrouter ALL=(root) NOPASSWD: /usr/bin/networkctl, /usr/bin/nmcli, /usr/sbin/nft, /usr/bin/wg, /usr/bin/wg-quick, /usr/local/sbin/altrouter-netapply, /usr/local/sbin/altrouter-ssh, /usr/bin/systemctl restart dnsmasq, /usr/bin/systemctl reload dnsmasq, /usr/bin/systemctl status dnsmasq, /usr/bin/systemctl start ssh, /usr/bin/systemctl stop ssh, /usr/bin/systemctl enable ssh, /usr/bin/systemctl disable ssh, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/apt-get update, /usr/bin/apt-get -y dist-upgrade, /usr/bin/tcpdump -nn -c 200 -i *
